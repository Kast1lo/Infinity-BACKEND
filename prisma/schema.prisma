datasource db {
  provider = "postgresql"
}

generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  moduleFormat  = "cjs"
}

model User {
  id                        String    @id @default(uuid())
  email                     String    @unique
  username                  String?   @unique
  passwordHash              String
  avatarKey                 String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  googleId                  String?   @unique

  isVerified                Boolean   @default(false)
  verificationCode          String?
  verificationCodeExpiresAt DateTime?

  resetCode                 String?
  resetCodeExpiresAt        DateTime?

  pendingEmail              String?
  emailChangeCode           String?
  emailChangeCodeExpiresAt  DateTime?

  planType      String    @default("spark")
  planExpiresAt DateTime?
  isFrozen      Boolean   @default(false)
  frozenAt      DateTime?
  storageUsed   BigInt    @default(0)

  aiCallsToday   Int       @default(0)
  aiCallsResetAt DateTime?

  // Robokassa: привязка карты и автопродление
  cardBound            Boolean @default(false)
  cardLast4            String?
  autoRenew            Boolean @default(false)
  recurringParentInvId Int?

  promoCode     PromoCode? @relation("UsedPromo")
  payments      Payment[]

  files         File[]
  folders       Folder[]
  tasks         Task[]
  projects      Project[]
  projectShares ProjectShare[]
  folderShares  FolderShare[]
  notifications Notification[]
  notes         Note[]
  noteImages    NoteImage[]

  @@index([email])
  @@index([planType])
  @@index([planExpiresAt])
}

model Note {
  id        String   @id @default(uuid())
  userId    String
  title     String   @default("")
  content   String   @default("")  // rich-text HTML
  color     String?
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isPinned, updatedAt])
}

// Картинки, вставленные в заметки. Хранятся в S3, отдаются публично по
// неугадываемому id (как файловые шары) — чтобы <img> грузился кросс-доменно.
model NoteImage {
  id        String   @id @default(uuid())
  userId    String
  path      String
  mimeType  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String    @default("system")
  title     String
  body      String?
  link      String?
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
  readAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model Payment {
  invId           Int       @id @default(autoincrement())  // Robokassa InvId
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planType        String                                   // pulse | horizon | eternal
  period          String                                   // month | year | once
  amount          Int                                      // рубли (целые)
  status          String    @default("pending")            // pending | success | fail
  isRecurringInit Boolean   @default(false)                // первый (привязочный) платёж рекуррента
  description     String?
  createdAt       DateTime  @default(now())
  paidAt          DateTime?

  @@index([userId])
  @@index([status])
}

model PromoCode {
  id        String    @id @default(uuid())
  code      String    @unique
  planType  String    @default("eternal")
  source    String    @default("manual")
  note      String?

  usedById  String?   @unique
  usedBy    User?     @relation("UsedPromo", fields: [usedById], references: [id], onDelete: SetNull)
  usedAt    DateTime?

  createdAt DateTime  @default(now())

  @@index([code])
  @@index([usedById])
}

model Project {
  id          String       @id @default(uuid())
  name        String
  description String?
  color       String?
  icon        String?
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  columns     TaskColumn[]
  tasks       Task[]
  shares      ProjectShare[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
}

model ProjectShare {
  id          String   @id @default(uuid())
  projectId   String
  userId      String
  role        String   @default("EDITOR")    // VIEWER | EDITOR
  status      String   @default("ACCEPTED")  // PENDING | ACCEPTED
  invitedById String?
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model TaskColumn {
  id        String   @id @default(uuid())
  name      String
  order     Int      @default(0)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([projectId, order])
}

model Task {
  id          String    @id @default(uuid())
  title       String
  notes       String?
  priority    Priority  @default(MEDIUM)
  isCompleted Boolean   @default(false)
  dueDate     DateTime?
  color       String?
  order       Int       @default(0)
  reminderSnoozedUntil DateTime?
  columnId    String?
  projectId   String
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  column      TaskColumn?      @relation(fields: [columnId], references: [id], onDelete: SetNull)
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subtasks    Subtask[]
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments TaskAttachment[]

  @@index([userId])
  @@index([columnId])
  @@index([projectId])
}

// Связь «задача ↔ файл из хранилища». Join-модель, а не File.taskId:
// один файл можно прикрепить к нескольким задачам, а открепление не удаляет
// сам файл из хранилища.
model TaskAttachment {
  id        String   @id @default(uuid())
  taskId    String
  fileId    String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([taskId, fileId])
  @@index([taskId])
  @@index([fileId])
}

model Subtask {
  id          String   @id @default(uuid())
  title       String
  isCompleted Boolean  @default(false)
  order       Int      @default(0)
  taskId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

model File {
  id          String   @id @default(uuid())
  name        String
  path        String
  size        BigInt
  mimeType    String?
  ownerId     String
  folderId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isShared    Boolean  @default(false)
  isStarred   Boolean  @default(false)
  downloadUrl String?
  deletedAt   DateTime?
  sharedAt          DateTime?
  shareExpiresAt    DateTime?
  sharePasswordHash String?
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  folder      Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  taskAttachments TaskAttachment[]

  @@index([ownerId, path])
  @@index([ownerId, deletedAt])
}

model Folder {
  id        String   @id @default(uuid())
  name      String
  path      String
  ownerId   String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isShared  Boolean  @default(false)
  isStarred Boolean  @default(false)
  deletedAt DateTime?
  sharedAt          DateTime?
  shareExpiresAt    DateTime?
  sharePasswordHash String?
  shareSlug         String?   @unique
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parent    Folder?  @relation("FolderToParent", fields: [parentId], references: [id], onDelete: SetNull)
  children  Folder[] @relation("FolderToParent")
  files     File[]
  shares    FolderShare[]

  @@index([ownerId, path])
  @@index([ownerId, deletedAt])
}

model FolderShare {
  id          String   @id @default(uuid())
  folderId    String
  userId      String
  role        String   @default("EDITOR")    // VIEWER | EDITOR
  status      String   @default("ACCEPTED")  // PENDING | ACCEPTED
  invitedById String?
  createdAt   DateTime @default(now())
  folder      Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([folderId, userId])
  @@index([userId])
}

